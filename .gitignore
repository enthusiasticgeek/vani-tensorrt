target/
vendor/
*.bak

# mdBook build output -- rebuilt fresh by CI each deploy.
/tutorials/book/

# Auto-generated by tools/gen_api_tutorial.py on every CI run (and
# locally, when you run it yourself) -- never committed, so the
# published tutorial can never drift stale relative to the source it
# describes. See tools/gen_api_tutorial.py's header comment.
/tutorials/src/index.md
/tutorials/src/api_reference.md
/tutorials/src/SUMMARY.md

# nvcc/cc build artifacts consumers produce locally -- never vendored
# (platform/GPU-arch specific, see manifest.rs's copy_dir_vani for why).
*.o
*.a
