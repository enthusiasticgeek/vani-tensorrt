// End-to-end example: load a pre-built TensorRT engine, discover its
// I/O tensors by name, allocate real device buffers, populate real
// input data, run inference asynchronously, read the real output
// back, and destroy everything cleanly. Build with:
//
//   vanic build inference_demo.vani --backend=c \
//     --link-with ../shims/vani_tensorrt_shim.cpp \
//     --link-with ../../vani-cuda/shims/vani_cuda_shim.c \
//     -lnvinfer -lcudart -lstdc++ \
//     -o inference_demo
//
// UNVERIFIED ON REAL HARDWARE (and unverified against a real
// TensorRT SDK at all -- see README.md's "Hardware verification
// status"). This file type-checks; it has not been run, and there is
// no model.engine file bundled with this example -- point
// `engine_path` at a real one built via `trtexec` if you have a
// current (TensorRT 10+) TensorRT install available. See
// `~/vani_gpu_hardware_testing_guide.md` for a full walkthrough,
// including generating a tiny throwaway ONNX model + engine to test
// against.
//
// Assumes vani-cuda is cloned as a SIBLING directory to vani-tensorrt
// (`../../vani-cuda` from this file) -- this package itself has no
// hard vani.toml dependency on it (see README.md), but real device
// memory ALLOCATION is a vani-cuda concern this package deliberately
// doesn't duplicate (unlike stream management and f32 memcpy, which
// it does, for the reasons explained in src/lib.vani). Every input
// tensor here is filled with the placeholder value 1.0 -- replace
// with your model's real input data for anything beyond a plumbing
// check.

use "../src/lib.vani";
use "../../vani-cuda/src/lib.vani";

fn main() -> i64 {
  let engine_path: Str = "model.engine";

  let runtime: i64 = trt_create_runtime();
  if runtime == 0 {
    eprint "trt_create_runtime failed";
    return 1;
  }

  let engine: i64 = trt_load_engine_from_file(runtime, engine_path);
  if engine == 0 {
    eprint "trt_load_engine_from_file failed -- see stderr above for TensorRT's own message";
    return 1;
  }

  let nb: i32 = trt_get_nb_io_tensors(engine);
  print "engine has", nb, "I/O tensors";

  let context: i64 = trt_create_execution_context(engine);
  if context == 0 {
    eprint "trt_create_execution_context failed";
    return 1;
  }

  // Discover each tensor's name/role/size, allocate a real device
  // buffer sized for it (f32, 4 bytes/element), populate real input
  // data, and bind its address.
  let placeholder: f32 = 1.0;
  let i: i32 = 0;
  while i < nb {
    let name: Str = trt_get_io_tensor_name(engine, i);
    let is_input: i32 = trt_tensor_is_input(engine, name);
    let n_elems: i64 = trt_get_tensor_num_elements(engine, name);
    if n_elems < 0 {
      eprint "dynamic-shape tensors are not yet supported by this package (see TODO.md)";
      return 1;
    }

    let dptr: i64 = 0;
    let rc_alloc: i32 = cuda_malloc(mut ref dptr, n_elems * 4);
    if rc_alloc != 0 {
      eprint "cuda_malloc failed for a tensor -- see cuda_error_string(rc_alloc)";
      return 1;
    }

    if is_input == 1 {
      print "tensor", name, "is an INPUT with", n_elems, "elements -- uploading data";
      let host_in: Vec<f32> = vec_fill(n_elems, placeholder);
      let rc_h2d: i32 = trt_memcpy_h2d_f32(dptr, ref host_in, n_elems);
      if rc_h2d != 0 {
        eprint "trt_memcpy_h2d_f32 failed for an input tensor";
        return 1;
      }
    } else {
      print "tensor", name, "is an OUTPUT with", n_elems, "elements";
    }

    let rc_addr: i32 = trt_set_tensor_address(context, name, dptr);
    if rc_addr == 0 {
      eprint "trt_set_tensor_address failed for a tensor";
      return 1;
    }
    i = i + 1;
  }

  let stream: i64 = trt_create_stream();
  if stream == 0 {
    eprint "trt_create_stream failed";
    return 1;
  }

  let ok: i32 = trt_enqueue(context, stream);
  if ok == 1 {
    let _ = trt_stream_synchronize(stream);
    print "inference succeeded -- read output tensors back with trt_memcpy_d2h_f32";
  } else {
    eprint "trt_enqueue failed -- see stderr above for TensorRT's own message";
  }

  let _ = trt_destroy_stream(stream);
  let _ = trt_destroy_execution_context(context);
  let _ = trt_destroy_engine(engine);
  let _ = trt_destroy_runtime(runtime);

  return 0;
}
